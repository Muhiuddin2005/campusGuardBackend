{
  "name": "campusguard-server",
  "version": "1.0.0",
  "description": "Backend API for CampusGuard - Anonymous Campus Incident Reporting and Disciplinary Board System",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "start": "node ./dist/src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:authority": "ts-node-dev ./scripts/createAuthority.ts",
    "test:integration": "ts-node-dev ./scripts/testBackend.ts"
  },
  "keywords": [
    "campusguard",
    "anonymous-reporting",
    "express",
    "prisma",
    "typescript"
  ],
  "author": "CampusGuard Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "prettier": "^3.5.3",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
