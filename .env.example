# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (Supabase / PostgreSQL)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusguard?schema=public"

# Cryptographic Pepper for Passcode Hashing (HMAC-SHA256)
# Generate a high-entropy secret string for production
PASSCODE_PEPPER="campusguard_passcode_pepper_secret_dev_2026"

# JWT Secret for Authority Authentication
JWT_SECRET="campusguard_authority_jwt_secret_dev_2026"
JWT_EXPIRES_IN="7d"

# Supabase Storage Configuration (Private bucket for media evidence)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_BUCKET="campusguard-media"
